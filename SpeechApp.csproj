<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>branding\App.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="2.0.1" />
    <PackageDownload Include="org.k2fsa.sherpa.onnx" Version="[2.0.1]" />
    <Reference Include="sherpa-onnx">
      <HintPath>$(NuGetPackageRoot)org.k2fsa.sherpa.onnx/2.0.1/lib/net10.0/sherpa-onnx.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="branding\App.ico" LogicalName="WindowIcon.ico" />
  </ItemGroup>
</Project>
